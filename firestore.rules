rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, create, update: if request.auth != null &&
        (request.auth.uid == userId || request.auth.token.email == "yomawisdom55@gmail.com");
      allow delete: if request.auth != null &&
        request.auth.token.email == "yomawisdom55@gmail.com";
    }
  }
}
